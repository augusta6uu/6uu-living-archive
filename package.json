{
  "name": "6uu-living-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "cv": "node scripts/build-cv.mjs",
    "build": "tsc --noEmit && node scripts/build-cv.mjs && vite build && vite build --ssr src/prerender.tsx --outDir .ssg && node .ssg/prerender.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
